# backend/.env.example
# Copy to backend/.env and fill in real values. NEVER commit the real .env
# (it is gitignored). On Railway/Render these are set as service env vars, not
# from a file. Values here are safe placeholders / documented defaults.

# ── Core ─────────────────────────────────────────────────────────────────────
# App crashes at startup if SECRET_KEY is unset. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-32-byte-hex-secret
ACCESS_TOKEN_EXPIRE_HOURS=8
# Comma-separated allowed browser origins for CORS. Set explicitly in prod.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Platform injects PORT at runtime; only needed for local `python main.py`.
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres in prod (Neon/Railway); falls back to local SQLite if unset.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Connection pool ceiling — keep pool_size+max_overflow under the DB plan's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Logging / observability ──────────────────────────────────────────────────
LOG_FORMAT=json          # json (prod) | plain (readable local dev)
LOG_LEVEL=INFO
SENTRY_DSN=              # optional; enables error + 20% perf tracing when set

# Critical-error alerting (see backend/alerting.py). Optional; a Slack-compatible
# incoming-webhook URL. Unset = alerting stays a silent no-op, same posture as
# every other optional integration below.
ALERT_WEBHOOK_URL=
ALERT_ERROR_SPIKE_THRESHOLD=5        # unhandled exceptions within the window below to fire
ALERT_ERROR_SPIKE_WINDOW_SECONDS=60
ALERT_COOLDOWN_SECONDS=300           # minimum gap between two alerts, so a sustained outage pages once, not on every request

# ── Request limits / proxy ───────────────────────────────────────────────────
# Trusted reverse-proxy hops in front of the app (Railway edge = 1). Used to read
# the real client IP from X-Forwarded-For for rate limiting — do not lower blindly.
TRUSTED_PROXY_HOPS=1
MAX_REQUEST_BODY_BYTES=1048576   # 1 MiB
GUNICORN_TIMEOUT=60
# Optional shared rate-limit store. Set to a Redis URL (or reuse REDIS_URL) once a
# Redis add-on is provisioned; this makes rate limiting correct under
# gunicorn --workers >1. Unset = in-memory store (single-worker, current default).
# RATE_LIMIT_STORAGE_URI=redis://default:pass@host:6379/0

# ── Feature flags (see feature_flags.py) ─────────────────────────────────────
# FEATURE_<NAME>=true|false overrides a flag's default without a redeploy.
# ai_narration (default true): master LLM switch. Set false to instantly stop ALL
#   LLM spend (dashboard narratives + WhatsApp fallback) and serve deterministic
#   data only — a cost/incident valve.
# FEATURE_AI_NARRATION=true
# FEATURE_CONVERSATION_MEMORY=false   # reserved for Phase 6

# ── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379           # sandbox paybill
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.up.railway.app/webhooks/mpesa/your-secret-token
MPESA_ENV=sandbox                # sandbox | production
# REQUIRED IN PROD: secret embedded in the callback URL path. If unset, the
# payment callback is UNAUTHENTICATED and forgeable — set a long random value.
MPESA_CALLBACK_TOKEN=

# ── Email (password reset + email verification, see email_utils.py) ────────
# Generic SMTP — no vendor lock-in. Missing/blank = the reset/verify link is
# logged instead of emailed (dev mode); the endpoints still work end-to-end.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL of the deployed frontend — used to build the links emailed to users.
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=48

# ── Twilio (WhatsApp + SMS) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
TWILIO_TIMEOUT_SECONDS=10
# Owner phone for WhatsApp routing (E.164). Prefer the Restaurant.owner_phone
# column; these env vars are the legacy fallback. Per-restaurant: OWNER_PHONE_{id}.
OWNER_PHONE=

# ── Web Push (VAPID) — staff notifications, independent of Twilio ────────────
# Costs nothing and needs no external account (see ai/notify.py). Generate a
# keypair once with the `vapid` CLI shipped by py-vapid (`vapid --gen`) or:
#   python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys()"
# Missing/blank = push silently no-ops; the in-app notification feed
# (routers/notifications.py) still works regardless.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email required by the VAPID spec (no "mailto:" prefix — added
# automatically in ai/notify.py). Push services may use this to reach you.
VAPID_CLAIM_EMAIL=

# ── Object storage (backend/storage.py) ──────────────────────────────────────
# Pluggable local-disk/S3 module for any future upload feature (menu photos,
# receipts). STORAGE_BACKEND=local (the default) writes to a folder on the
# container's own disk — fine for local dev, but NOT SAFE ON RAILWAY: the
# filesystem is ephemeral, so anything written there is lost on the next
# redeploy/restart. Set STORAGE_BACKEND=s3 in production before wiring up any
# upload endpoint to this module.
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
STORAGE_S3_PUBLIC_BASE=          # e.g. https://cdn.example.com — optional
# AWS credentials for the s3 backend are read by boto3 from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION env vars — set those
# directly (not STORAGE_-prefixed) if not using an IAM instance role.

# ── LLM provider (pick one; Groq is the default configured today) ────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=               # set to auto-upgrade the whole tier table to Claude
ANTHROPIC_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional context-compression proxy (Anthropic path only)
HEADROOM_ENABLED=true
HEADROOM_PROXY_URL=
