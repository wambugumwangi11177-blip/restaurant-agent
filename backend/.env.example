# backend/.env.example
# Copy to backend/.env and fill in real values. NEVER commit the real .env
# (it is gitignored). On Railway/Render these are set as service env vars, not
# from a file. Values here are safe placeholders / documented defaults.

# ── Core ─────────────────────────────────────────────────────────────────────
# App crashes at startup if SECRET_KEY is unset. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-32-byte-hex-secret
ACCESS_TOKEN_EXPIRE_HOURS=8
# Comma-separated allowed browser origins for CORS. Set explicitly in prod.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Platform injects PORT at runtime; only needed for local `python main.py`.
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres in prod (Neon/Railway); falls back to local SQLite if unset.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Connection pool ceiling — keep pool_size+max_overflow under the DB plan's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Logging / observability ──────────────────────────────────────────────────
LOG_FORMAT=json          # json (prod) | plain (readable local dev)
LOG_LEVEL=INFO
SENTRY_DSN=              # optional; enables error + 20% perf tracing when set

# ── Request limits / proxy ───────────────────────────────────────────────────
# Trusted reverse-proxy hops in front of the app (Railway edge = 1). Used to read
# the real client IP from X-Forwarded-For for rate limiting — do not lower blindly.
TRUSTED_PROXY_HOPS=1
MAX_REQUEST_BODY_BYTES=1048576   # 1 MiB
GUNICORN_TIMEOUT=60
# Optional shared rate-limit store. Set to a Redis URL (or reuse REDIS_URL) once a
# Redis add-on is provisioned; this makes rate limiting correct under
# gunicorn --workers >1. Unset = in-memory store (single-worker, current default).
# RATE_LIMIT_STORAGE_URI=redis://default:pass@host:6379/0

# ── Feature flags (see feature_flags.py) ─────────────────────────────────────
# FEATURE_<NAME>=true|false overrides a flag's default without a redeploy.
# ai_narration (default true): master LLM switch. Set false to instantly stop ALL
#   LLM spend (dashboard narratives + WhatsApp fallback) and serve deterministic
#   data only — a cost/incident valve.
# FEATURE_AI_NARRATION=true
# FEATURE_CONVERSATION_MEMORY=false   # reserved for Phase 6

# ── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379           # sandbox paybill
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.up.railway.app/webhooks/mpesa/your-secret-token
MPESA_ENV=sandbox                # sandbox | production
# REQUIRED IN PROD: secret embedded in the callback URL path. If unset, the
# payment callback is UNAUTHENTICATED and forgeable — set a long random value.
MPESA_CALLBACK_TOKEN=

# ── Twilio (WhatsApp + SMS) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
TWILIO_TIMEOUT_SECONDS=10
# Owner phone for WhatsApp routing (E.164). Prefer the Restaurant.owner_phone
# column; these env vars are the legacy fallback. Per-restaurant: OWNER_PHONE_{id}.
OWNER_PHONE=

# ── LLM provider (pick one; Groq is the default configured today) ────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=               # set to auto-upgrade the whole tier table to Claude
ANTHROPIC_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional context-compression proxy (Anthropic path only)
HEADROOM_ENABLED=true
HEADROOM_PROXY_URL=
