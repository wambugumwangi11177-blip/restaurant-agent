{
  "version": 5,
  "note": "Ordering rule first, then store flow. Answers unlock modules and persist routing on the restaurant.",
  "questions": [
    {
      "id": "ordering_method",
      "prompt": "How do you order stock today?",
      "answers": [
        {"value": "owner_approves", "label": "The owner approves, then I place the order"},
        {"value": "staples_self", "label": "I order everyday staples myself (max quantity per item only)"},
        {"value": "flag_office", "label": "The owner or accountant orders after I flag low stock"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "receives_deliveries",
      "prompt": "Do you take in deliveries?",
      "answers": [
        {"value": "yes", "label": "Yes", "opens": "/store/deliveries", "unlocks": "deliveries"},
        {"value": "no", "label": "No", "opens": "/store"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "supplier_list",
      "kind": "suppliers",
      "prompt": "Who are the suppliers? Name what each brings and how the supplies arrive.",
      "brings": ["Main food", "Alcohol", "Both", "Other"],
      "arrivals": [
        {"value": "phone", "label": "Phone order"},
        {"value": "scheduled", "label": "Scheduled delivery"},
        {"value": "pickup", "label": "Pickup"},
        {"value": "other", "label": "Other"}
      ],
      "answers": [
        {"value": "listed", "label": "I'll name them", "opens": "/store/suppliers", "unlocks": "suppliers"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "stock_in_pos",
      "prompt": "Are inventory items kept in the POS or server?",
      "answers": [
        {"value": "yes", "label": "Yes", "opens": "/store"},
        {"value": "no", "label": "No", "opens": "/store"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "issues_to_kitchen",
      "prompt": "Do you hand stock from the store to the kitchen?",
      "answers": [
        {"value": "yes", "label": "Yes", "opens": "/store/issue", "unlocks": "store-issue"},
        {"value": "no", "label": "No", "opens": "/store"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "records_waste",
      "prompt": "Do you write down food that is thrown away?",
      "answers": [
        {"value": "yes", "label": "Yes", "opens": "/store/waste", "unlocks": "waste"},
        {"value": "no", "label": "No", "opens": "/store"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "closes_the_day",
      "prompt": "Who closes the day?",
      "answers": [
        {"value": "me", "label": "I do", "opens": "/store", "unlocks": "day-close"},
        {"value": "owner", "label": "The owner", "opens": "/store"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}
      ]
    },
    {
      "id": "knows_running_costs",
      "prompt": "Do you know what we pay for rent, gas, electricity, water, salaries, and other regular bills?",
      "answers": [
        {"value": "knows_payer", "label": "I know who pays it", "opens": "/store/costs", "unlocks": "running-costs"},
        {"value": "no", "label": "No", "opens": "/store"},
        {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "accountant"}
      ]
    },
    {"id": "zones", "prompt": "Where is stock kept?", "answers": [{"value": "listed", "label": "Main store, cold room, bar, kitchen", "opens": "/store/stock"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "buying_units", "prompt": "Do you buy in one unit and use in another?", "answers": [{"value": "yes", "label": "Yes", "opens": "/store/stock"}, {"value": "no", "label": "No", "opens": "/store"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "handover_who", "prompt": "When stock goes to the kitchen, who takes it and who signs?", "answers": [{"value": "chef_pin", "label": "Chef signs with PIN on this phone", "opens": "/store/issue"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "handover_when", "prompt": "At what times do you hand over on a normal day?", "answers": [{"value": "lunch_dinner", "label": "Before lunch and before dinner", "opens": "/store/issue"}, {"value": "once", "label": "Once a day", "opens": "/store/issue"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "has_scale", "prompt": "Is there a weighing scale in the store or kitchen?", "answers": [{"value": "yes", "label": "Yes"}, {"value": "no", "label": "No — I use photos", "opens": "/store/stock"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "waste_approver", "prompt": "Who approves waste or spoilage?", "answers": [{"value": "owner", "label": "Owner"}, {"value": "manager", "label": "Manager"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "count_rhythm", "prompt": "How often is the store counted, and who counts with you?", "answers": [{"value": "daily_pair", "label": "Daily with a second person", "opens": "/store/close"}, {"value": "weekly", "label": "Weekly", "opens": "/store/close"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "par_and_max", "prompt": "For staples, what par level and max order qty should we never cross?", "answers": [{"value": "per_item", "label": "I'll set each item", "opens": "/store/stock", "unlocks": "opening-count"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "who_pays", "prompt": "Who pays suppliers, and who keeps the invoice?", "answers": [{"value": "accountant", "label": "Accountant pays, I keep the paper", "opens": "/store/deliveries"}, {"value": "owner", "label": "Owner", "opens": "/store"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "prep_ahead", "prompt": "Which dishes are prepped before service?", "answers": [{"value": "yes", "label": "Yes — I'll name them", "opens": "/store/prep", "unlocks": "prep-list"}, {"value": "no", "label": "No"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]},
    {"id": "portions", "prompt": "Does the chef measure portions, or cook by eye?", "answers": [{"value": "measured", "label": "Measured", "opens": "/store/recipes"}, {"value": "eye", "label": "By eye", "opens": "/store/recipes"}, {"value": "unknown", "label": "I don't know", "delegate": true, "delegate_to": "owner"}]}
  ]
}