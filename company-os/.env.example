# Copy to backend/.env for local development. Never commit real values.
ENV=development
DATABASE_URL=postgresql+psycopg2://cos:cos@localhost:5432/cos_dev
JWT_SECRET=change-me-to-48-random-characters-in-production
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# LLM: first key present wins (OpenRouter -> Anthropic -> Groq). None = deterministic mode.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5          # per tier: ANTHROPIC_MODEL_LOW / _MEDIUM / _HIGH
# MODEL_PRICES_JSON={"<model-id>": [<usd_per_1M_input>, <usd_per_1M_output>]}   # take prices from your provider; unknown models bill at a conservative $5/$25
DAILY_LLM_SPEND_CAP_USD=5

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Email via SMTP (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
