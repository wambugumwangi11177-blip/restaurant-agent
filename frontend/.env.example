# frontend/.env.example — copy to .env.local for local dev, and set the same
# vars in Vercel → Project → Settings → Environment Variables for deployments.
#
# NEXT_PUBLIC_API_URL is the browser-side base URL of the FastAPI backend.
#   Local dev:  http://localhost:8000
#   Production: your Railway public domain, e.g. https://<service>.up.railway.app
#   (Railway → Service → Settings → Networking → Generate Domain)
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time on Vercel — after changing
# them you must REDEPLOY, not just save.
NEXT_PUBLIC_API_URL=http://localhost:8000
