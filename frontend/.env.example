# frontend/.env.example
# Copy to frontend/.env.local for local dev. On Vercel these are set as
# project env vars, per-environment (Production / Preview / Development) —
# not from a file.
#
# Every NEXT_PUBLIC_* var is baked into the client bundle at build time. That
# is exactly why NEXT_PUBLIC_ENABLE_DEMO_DATA below defaults to unset/false:
# a var that's easy to leave on is a var that ends up shown to a real
# restaurant by accident.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo data (added 2026-08-06): shows fabricated "Lavy restaurant" numbers on
# the dashboard/sales/inventory pages when a tenant's real data is empty —
# useful for a sales walkthrough, wrong for a live restaurant with no data
# yet (a genuinely empty account should show zeros, not someone else's fake
# revenue). Leave unset in every environment except a dedicated demo/sales
# deployment. See frontend/src/lib/demo-data.ts.
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true
