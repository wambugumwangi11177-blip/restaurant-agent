  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true
  },
  "meta": {
    "leviiiNotes": [
      "Replaces main.py's in-process APScheduler. Same thirteen jobs, same times.",
      "The app still holds the logic; this only owns the trigger, the retry and the history.",
      "Set ENABLE_INTERNAL_SCHEDULER=false on Railway ONLY after this has run clean for a day \u2014",
      "running both is duplicated work, running neither is silence, and silence is worse.",
      "Each job returns 500 on failure so n8n's own retry and alerting fire.",
      "A job already running returns 409, so a retry cannot double-send WhatsApp messages."
    ]
  },
  "active": false
